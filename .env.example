# Dev: 비워두면 Vite 프록시가 /auth 요청을 백엔드로 포워딩 (vite.config.ts 참고)
# Prod: 실제 백엔드 도메인 입력 (예: https://api.example.com)
VITE_API_BASE_URL=

# Dev: true 면 /inspection-order, /inspection/slots, POST /inspection, /inspection/my 를
# axios adapter 단에서 mock 응답으로 가로챈다. (src/features/inspection/api/mockInterceptor.ts)
# 서버 연동 시 빈 값으로 두거나 false 로 설정.
VITE_MOCK_INSPECTION=

# --- FCM 웹 푸시 ---
# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) 의 firebaseConfig 값들.
# VAPID 키는 프로젝트 설정 → 클라우드 메시징 → "웹 푸시 인증서" 의 공개키.
#
# 하나라도 비어 있으면 웹 푸시는 꺼지고, 알림을 허용한 사용자에게
# "탭이 열려 있는 동안만" 뜨는 브라우저 알림으로 동작한다.
# 즉 값을 넣지 않은 채 배포해도 안전하다.
#
# 운영에 반영하려면 Vercel 프로젝트 설정의 Environment Variables 에도 넣어야 한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
